{
  "name": "Ambush",
  "events": [
    {
      "trigger": "LEVEL_START",
      "actions": [
        {
          "type": "DIALOGUE",
          "lines": [
            "FPV drone inbound! It's on an attack run!",
            "Lock onto its signal and jam it before impact!"
          ]
        },
        { "type": "SPAWN", "id": "fpv_1", "angle": 90.0, "distance": 1.0, "eta": 60.0, "waves": [[0.2, 0.4, 0.5]] }
      ]
    },
    {
      "trigger": "ATTACK_DEFEATED",
      "target": "drone_1",
      "actions": [
        { "type": "CANCEL_TIMER", "id": "hurry_warning" },
        {
          "type": "DIALOGUE",
          "lines": [
            "FPV drone neutralized!",
            "Radar is clear... wait a moment."
          ]
        },
        { "type": "START_TIMER", "id": "ambush_timer", "duration": 3.0 }
      ]
    },
    {
      "id": "ambush_event",
      "trigger": "TIMER_COMPLETED",
      "target": "ambush_timer",
      "actions": [
        {
          "type": "DIALOGUE",
          "lines": [
            "CONTACTS! Two new signals just appeared!",
            "One is moving much faster than the other!",
            "Use the radar dial! Take out the rocket first!"
          ]
        },
        { "type": "SPAWN", "id": "drone_2", "angle": 120.0, "distance": 1.0, "eta": 90.0, "waves": [[0.5, 0.2, 0.0]] },
        { "type": "SPAWN", "id": "rocket_1", "angle": 130.0, "distance": 1.0, "eta": 30.0, "waves": [[1.0, 0.1, 0.5]] }
      ]
    },
    {
      "trigger": "ATTACK_DEFEATED",
      "target": "rocket_1",
      "actions": [
        {
          "type": "DIALOGUE",
          "lines": [
            "Rocket neutralized! Good catch!"
          ]
        }
      ]
    }
  ]
}
